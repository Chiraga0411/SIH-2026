  "kbDocs": [
    {
      "id": "kb_sop114",
      "name": "SOP-114 Pressure vessel inspection.pdf",
      "type": "SOP",
      "pages": 42,
      "clearance": "Internal",
      "ingested": "12 Mar",
      "chunks": [
        {
          "page": 3,
          "text": "This SOP applies to pressure vessels in the crude and vacuum distillation units, including P-101 and P-102."
        },
        {
          "page": 12,
          "text": "Minimum permissible shell thickness for class II vessels is 8.5 mm after corrosion allowance."
        },
        {
          "page": 12,
          "text": "Measured thickness below the minimum requires a follow-up inspection before the vessel is returned to service."
        },
        {
          "page": 14,
          "text": "Ultrasonic thickness readings shall be recorded at five grid points on the shell and two on the head."
        },
        {
          "page": 21,
          "text": "Corrosion rate above 0.25 mm/year triggers an internal inspection within six months."
        }
      ]
    },
    {
      "id": "kb_cdu_manual",
      "name": "MRPL CDU operating manual.pdf",
      "type": "Manual",
      "pages": 196,
      "clearance": "Internal",
      "ingested": "12 Mar",
      "chunks": [
        {
          "page": 45,
          "text": "Relief protection for the P-101 system is provided by PSV-140 installed on line L-2210."
        },
        {
          "page": 64,
          "text": "P-101 feeds the fractionation section; discharge pressure is controlled by FV-2203 on line L-2203."
        },
        {
          "page": 88,
          "text": "Vessels outside tolerance require a follow-up inspection before return to service."
        },
        {
          "page": 120,
          "text": "Instrument PT-101 measures shell pressure and transmits to the control room."
        }
      ]
    },
